@page "/"
@using SeatBooking.Models
@inject SeatService SeatService

<PageTitle>Home</PageTitle>

<h1>Movies</h1>

<p>Welcome to the SeatBooking application! This application allows you to browse and book seats for your favorite
    movies. Explore our collection of movies, select your preferred showtime, and reserve your seats with ease. Enjoy a
    seamless movie booking experience!</p>

    <div class="container mb-4">
        <div class="movies-box pt-3">
            @foreach (var movie in movies)
            {
                <article class="card movie-card">
                    <img class="card-img-top" src="@movie.ImageUrl" alt="@movie.Name"
                         style="min-height: 425px;">
                    <div class="card-body d-flex flex-column">
                        <div class="mb-3">
                            <h5 class="card-title">@movie.Name</h5>
                            <p class="card-text">@movie.Description</p>
                        </div>
                        <button class="btn btn-primary mt-auto">Book Seat</button>
                    </div>
                </article>
            }
        </div>
    </div>

@code {
    private List<Movie> movies = [];

    protected override void OnInitialized()
    {
        movies = SeatService.GetMovies();
    }
}