@page "/"
@using SeatBooking.Models
@inject SeatService SeatService

<PageTitle>Главная</PageTitle>

<h1>Фильмы</h1>

<p>Добро пожаловать в приложение SeatBooking! Это приложение позволяет просматривать и бронировать места на ваши любимые
    фильмы. Изучите нашу коллекцию фильмов, выберите желаемое время сеанса и с легкостью зарезервируйте места.
    Наслаждайтесь удобным процессом бронирования билетов в кино!</p>

    <div class="container mb-4">
        <div class="movies-box pt-3">
            @foreach (var movie in movies)
            {
                <article class="card movie-card">
                    <img class="card-img-top" src="@movie.ImageUrl" alt="@movie.Name" style="min-height: 425px; height: 100%">
                    <div class="card-body d-flex flex-column">
                        <div class="mb-3">
                            <h5 class="card-title">@movie.Name</h5>
                            <div class="d-flex align-items-center">
                                @foreach (var genre in movie.Genre)
                                {
                                    <span class="pe-1">@genre@(genre != movie.Genre.Last() ? "," : "")</span>
                                }
                            </div>
                        </div>
                        <a href="/movie/@movie.Id" class="btn btn-primary mt-auto">Выбрать</a>
                    </div>
                </article>
            }
        </div>
    </div>

@code {
    private List<Movie> movies = [];

    protected override void OnInitialized()
    {
        movies = SeatService.GetMovies();
    }
}