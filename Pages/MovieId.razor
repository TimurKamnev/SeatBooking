@page "/movie/{Id}"
@using SeatBooking.Models
@inject SeatService SeatService

@if (movie == null)
{
    <p>Фильм не найден</p>
}
else
{
    <PageTitle>Movie - @movie.Name</PageTitle>

    <div class="container my-4">
        <a href="/" class="btn btn-primary mb-4">Назад к списку фильмов</a>

        <h1>@movie.Name</h1>

        <p class="mb-5">@movie.Description</p>

        <div class="d-flex justify-content-center">
            <div class="seat-grid m-auto">
                @foreach (var row in movie.Seats)
                {
                    <div class="seat-row">
                        @foreach (var seat in row)
                        {
                            <button class="seat @GetSeatClass(seat.Status)" disabled="@(seat.Status == PlaceStatus.Occupied)"
                                    @onclick="() => SeatService.ToggleSeat(movie.Id, seat.Id)">
                            </button>
                        }
                    </div>
                }
            </div>
        </div>


        <div class="screen mt-4 mb-5">ЭКРАН</div>


        <div class="legend mt-3 d-flex gap-3">
            <span><span class="d-block seat free"></span> Свободное</span>
            <span><span class="d-block seat selected"></span> Выбранное</span>
            <span><span class="d-block seat occupied"></span> Занято </span>
        </div>

        <div class="mt-3">
            <div class="d-flex gap-4">
                <p>Выбранные места: @GetSelectedCount()</p>
                <strong class="form-label">Максимальное кол-во выбранных мест - 8</strong>
            </div>
            <button class="btn btn-danger" @onclick="() => SeatService.ResetSeats(movie.Id)">
                Сбросить
            </button>
            <button class="btn btn-primary" @onclick="() => SeatService.BookSeats(movie.Id)"
                    disabled="@(GetSelectedCount() == 0)">
                Забронировать
            </button>
        </div>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = "";
    private Movie? movie;

    protected override void OnInitialized()
    {
        movie = SeatService.GetMovie(Id);
    }

    private string GetSeatClass(PlaceStatus status) => status switch
    {
        PlaceStatus.Selected => "selected",
        PlaceStatus.Occupied => "occupied",
        _ => "free"
    };

    private int GetSelectedCount() =>
        movie?.Seats.SelectMany(s => s).Count(s => s.Status == PlaceStatus.Selected) ?? 0;
}